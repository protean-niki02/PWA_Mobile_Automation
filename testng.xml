<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Default suite. The server picks the app by user agent:
    desktop browsers get the Next.js marketplace, mobile browsers get the Flutter PWA.
-->
<suite name="PWA Smoke">

    <test name="Desktop">
        <parameter name="device" value="desktop"/>
        <classes>
            <class name="tests.DesktopSmokeTest"/>
        </classes>
    </test>

    <test name="Android">
        <parameter name="device" value="android"/>
        <classes>
            <class name="tests.PwaSmokeTest"/>
        </classes>
    </test>

    <test name="iOS">
        <parameter name="device" value="ios"/>
        <classes>
            <class name="tests.PwaSmokeTest"/>
        </classes>
    </test>

</suite>
