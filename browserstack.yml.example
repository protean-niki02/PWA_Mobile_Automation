# Copy this file to browserstack.yml (which is git-ignored) and fill in your own BrowserStack credentials,
# or leave the two lines below as they are and set the environment variables BROWSERSTACK_USERNAME and
# BROWSERSTACK_ACCESS_KEY. Never commit real credentials.
userName: ${BROWSERSTACK_USERNAME}
accessKey: ${BROWSERSTACK_ACCESS_KEY}

framework: testng

platforms:
  # Windows desktop - Chrome
  - os: Windows
    osVersion: "11"
    browserName: chrome
    browserVersion: latest

  # macOS desktop - WebKit (Safari's engine; BrowserStack's Playwright has no plain "safari")
  - os: OS X
    osVersion: Sequoia
    browserName: playwright-webkit
    browserVersion: latest

browserstackLocal: false

projectName: Bima-Sugam-Mobile
buildName: Android iOS PWA Cross Browser Testing
buildIdentifier: "${BUILD_NUMBER}"

debug: true
networkLogs: true
consoleLogs: info
