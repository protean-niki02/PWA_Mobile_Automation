<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Sprint 1 test cases, on Android and on iOS. The run ends with a table of how long
    each TC took per platform, also saved as test-evidence/<run>/timing-summary.csv.

    Eclipse: right-click this file > Run As > TestNG Suite (needs the TestNG plugin)
    Maven:   mvn test "-Dsuite=testng-sprint1.xml"
    To leave a TC out, comment out its <class> line; to leave a platform out, comment out its <test>.
-->
<suite name="Sprint 1" verbose="1">

    <test name="SC_01 Launch Icon &amp; Splash Screen - Android">
        <parameter name="device" value="android"/>
        <classes>
            <class name="tests.sprint1.splashscreen.SC01_TC001_LaunchIconDisplayedTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC002_LaunchIconMatchesDesignTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC003_SplashScreenImagesDisplayedTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC004_SplashScreenMatchesDesignTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC005_GridTilesOnOnboardingTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC006_GridTilesOnSplashTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC007_GridTilesOnLoginTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC008_GridTilesMatchDesignTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC009_BrandingOnOnboardingTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC010_BrandingOnSplashTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC011_BrandingOnLoginTest"/>
        </classes>
    </test>

    <test name="SC_01 Launch Icon &amp; Splash Screen - iOS">
        <parameter name="device" value="ios"/>
        <classes>
            <class name="tests.sprint1.splashscreen.SC01_TC001_LaunchIconDisplayedTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC002_LaunchIconMatchesDesignTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC003_SplashScreenImagesDisplayedTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC004_SplashScreenMatchesDesignTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC005_GridTilesOnOnboardingTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC006_GridTilesOnSplashTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC007_GridTilesOnLoginTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC008_GridTilesMatchDesignTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC009_BrandingOnOnboardingTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC010_BrandingOnSplashTest"/>
            <class name="tests.sprint1.splashscreen.SC01_TC011_BrandingOnLoginTest"/>
        </classes>
    </test>

</suite>
